# Required in production (Render blueprint generates this automatically).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Optional: override the default keyless public APIs
# OSRM_URL=https://router.project-osrm.org
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# PHOTON_URL=https://photon.komoot.io/api/
# API_RATE=60/min
# HTTP_TIMEOUT=20
# LOG_LEVEL=INFO
# CACHE_DIR=/tmp/truck-routing-cache
